{
  "name": "@repo/database",
  "private": true,
  "version": "0.0.0",
  "description": "Drizzle ORM schema, migrations, tenant-scoped repositories and seeding \u2014 see docs/data/03_DATABASE_STRATEGY.md",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@repo/ai": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/runtime": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
