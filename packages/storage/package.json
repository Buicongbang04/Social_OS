{
  "name": "@repo/storage",
  "private": true,
  "version": "0.0.0",
  "description": "S3-compatible object storage — MinIO in development, S3 or R2 in production. See docs/data/06_OBJECT_STORAGE.md",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@repo/core": "workspace:*",
    "@repo/runtime": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
