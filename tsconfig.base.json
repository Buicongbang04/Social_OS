{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@repo/core": ["packages/core/src"],
      "@repo/runtime": ["packages/runtime/src"],
      "@repo/domain": ["packages/domain/src"],
      "@repo/database": ["packages/database/src"],
      "@repo/auth": ["packages/auth/src"],
      "@repo/ai": ["packages/ai/src"],
      "@repo/integration": ["packages/integration/src"],
      "@repo/plugin": ["packages/plugin/src"],
      "@repo/sdk": ["packages/sdk/src"],
      "@repo/ui": ["packages/ui/src"],
      "@repo/config/*": ["packages/config/*"],
      "@repo/logger": ["packages/logger/src"],
      "@repo/event": ["packages/event/src"],
      "@repo/queue": ["packages/queue/src"],
      "@repo/storage": ["packages/storage/src"],
      "@repo/shared": ["packages/shared/src"],
      "@repo/testing": ["packages/testing/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "coverage"]
}
