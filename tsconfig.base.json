{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  // NOTE: no `paths` mapping on purpose. Internal packages are resolved through
  // pnpm's workspace symlinks in node_modules, pointing at each package's built
  // `dist/*.d.ts`. Mapping `@repo/*` straight at `packages/*/src` would drag a
  // dependency's source files into the consumer's compilation and trip TS6059
  // ("not under rootDir"). Turborepo's `dependsOn: ["^build"]` guarantees a
  // dependency is built before anything that consumes it.
  "exclude": ["node_modules", "dist", ".next", ".turbo", "coverage"]
}
