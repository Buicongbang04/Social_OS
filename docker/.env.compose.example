# Biến môi trường khi chạy cả cụm bằng Docker.
#
# KHÔNG dùng chung với `.env` ở gốc repo. `.env` dành cho `pnpm dev`, nơi các
# service chạy trên máy và gọi vào cổng đã publish (`localhost:5433`). Trong
# compose, chúng gọi nhau bằng **tên service** và cổng gốc (`postgres:5432`).
# Dùng nhầm file là lỗi "connection refused" mà mọi thứ trông đều đúng.
#
#   cp docker/.env.compose.example docker/.env.compose
#   # điền các giá trị bắt buộc bên dưới
#   docker compose --env-file docker/.env.compose \
#     -f docker/docker-compose.yml -f docker/docker-compose.app.yml up -d --build

# --- Bắt buộc: không có thì compose từ chối khởi động ---
# Trong mạng container: tên service, cổng gốc.
DATABASE_URL=postgres://ai_social_os:ai_social_os@postgres:5432/ai_social_os
REDIS_URL=redis://redis:6379
# Sinh mới cho mỗi lần cài. Đổi khoá này là mọi phiên đăng nhập hiện có mất hiệu lực.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# --- Nơi trình duyệt gọi tới ---
# NEXT_PUBLIC_API_URL được **nhúng lúc build image web**, không đọc lúc chạy.
# Đổi nó phải build lại. Đây là URL trình duyệt của người dùng gọi được, không
# phải tên service trong compose.
NEXT_PUBLIC_API_URL=http://localhost:3100/api/v1
CORS_ORIGINS=http://localhost:3200
# Dùng để dựng redirect_uri gửi cho nền tảng mạng xã hội. Phải là URL công khai
# thật khi triển khai, và phải khớp từng ký tự với URI đã đăng ký bên đó.
API_PUBLIC_URL=http://localhost:3100
WEB_APP_URL=http://localhost:3200

# --- Hạ tầng phụ, cũng theo tên service ---
QDRANT_URL=http://qdrant:6333
MINIO_URL=http://minio:9000
# Link tải được KÝ bằng host này. Ký bằng tên nội bộ thì trình duyệt bên ngoài
# không mở được, và chữ ký phủ cả host nên không sửa URL sau khi ký được.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=ai_social_os
MINIO_ROOT_PASSWORD=ai_social_os_secret
MINIO_BUCKET=documents
MINIO_REGION=us-east-1

# --- AI. Bỏ trống thì nền tảng vẫn chạy, phần cần model sẽ nói rõ là chưa cấu hình ---
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Bảng xu hướng YouTube. Google Trends không cần khoá.
YOUTUBE_API_KEY=

# Báo lỗi qua email. Để trống thì không gửi gì. Xem .env.example để biết cách
# lấy App Password của Gmail.
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
APP_URL=http://localhost:3200
# Ollama chạy trên máy chủ, không trong compose: từ container phải gọi ra ngoài.
# Phải có `/v1` — adapter dùng giao thức tương thích OpenAI. Thiếu nó thì mọi
# lời gọi trả về 'Not Found', và thông báo đó không hề nhắc tới đường dẫn.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
AI_EMBEDDING_MODEL=nomic-embed-text
# Model chạy cục bộ chậm hơn hẳn dịch vụ đám mây, và chậm hơn nữa khi cả cụm
# cùng chia CPU. Mặc định của thư viện quá ngắn cho một lượt chat 7B.
AI_TIMEOUT_MS=300000

# --- Kho bí mật. Mất khoá là mất mọi credential đã lưu, không có đường khôi phục ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEYS=
SECRET_PRIMARY_KEY=v1

# --- Đăng bài. Cả hai mặc định TẮT ---
# Bật là mọi Goal đã có sẵn, kể cả lịch tự chạy không ai ngồi xem, bắt đầu đăng
# ra ngoài từ lần chạy kế tiếp.
SOCIAL_PUBLISH_LIVE=false
SOCIAL_PUBLISH_UNATTENDED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Metrics. Bỏ trống thì endpoint trả 404 và coi như không tồn tại ---
METRICS_TOKEN=
