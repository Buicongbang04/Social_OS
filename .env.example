# Copy to .env and fill in real values locally. Never commit the real .env file.
#
# NOTE: Host ports below are deliberately offset from the usual defaults
# (5432/6379/3000) so this stack can run alongside other local projects
# without port conflicts. Container-internal ports stay standard.

# --- App ---
NODE_ENV=development
API_PORT=3100
API_PREFIX=api/v1

# --- PostgreSQL (packages/database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_social_os
POSTGRES_PASSWORD=ai_social_os
POSTGRES_DB=ai_social_os
DATABASE_URL=postgresql://ai_social_os:ai_social_os@localhost:5433/ai_social_os

# --- Redis (packages/queue, cache, session) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- MinIO (packages/storage) ---
MINIO_ENDPOINT=localhost
# Full URL the API and workers connect to. Storage is off when this is unset.
MINIO_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=ai_social_os
MINIO_ROOT_PASSWORD=ai_social_os_secret
MINIO_BUCKET=ai-social-os
# Largest file the API accepts, in megabytes.
UPLOAD_MAX_MB=25

# --- Qdrant (packages/ai — Vector DB for RAG/Knowledge/Memory) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- Auth (packages/auth, services/api) ---
# Required, min 32 chars, no default. Generate: openssl rand -base64 48
AUTH_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# argon2id cost; lower these in CI only, never in production.
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2

# --- API Gateway (docs/platform/09_API_GATEWAY.md) ---
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_WORKSPACE_PER_HOUR=10000
PERMISSION_CACHE_TTL_SECONDS=300

# --- AI Provider Gateway (packages/ai, docs/runtime/05_PROVIDER_GATEWAY.md) ---
# Leave AI_PROVIDER empty to run without any AI vendor: the runtime falls back
# to the deterministic Phase 1 Intent/Planning engines, so a Goal still runs
# end to end with no key and no spend.
#
# Comma-separated, most preferred first — the rest are the fallback chain:
#   AI_PROVIDER=anthropic,openai
# A provider named here without its key below is skipped rather than queued as
# a certain 401.
AI_PROVIDER=
# Optional. Overrides each provider's default model; leave empty to use it.
AI_MODEL=
# Embeddings need their OWN model — AI_MODEL names a chat model, and asking a
# chat model to embed fails outright. Leave empty to use the provider's
# default (OpenAI text-embedding-3-small, Google text-embedding-004, Ollama
# nomic-embed-text). Anthropic has no embedding API, so a chain starting with
# Anthropic quietly embeds via the next provider that can.
#
# Changing this after documents are indexed means a new Qdrant collection and
# a re-index: vectors from two models cannot be compared.
AI_EMBEDDING_MODEL=
AI_TIMEOUT_MS=60000
AI_ATTEMPTS=3

# How often the runtime looks for uploaded documents to index, in ms.
INDEX_INTERVAL_MS=5000

# Keys are read from the environment, not from a per-workspace Secret Manager.
# FR-031 ("workspace brings its own key") needs an encrypted secrets store that
# does not exist yet — this is the documented interim, not the end state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local Ollama needs no key. Default: http://localhost:11434/v1
OLLAMA_BASE_URL=

# --- Frontend (apps/web) ---
# Browser origins allowed to call the API, comma-separated. Never `*`: the
# access token travels in an Authorization header, so a wildcard would let any
# site make authenticated calls for a signed-in user.
CORS_ORIGINS=http://localhost:3200
# Where apps/web sends its requests. Must match API_PORT + API_PREFIX above.
NEXT_PUBLIC_API_URL=http://localhost:3100/api/v1
