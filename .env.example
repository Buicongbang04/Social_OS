# Copy to .env and fill in real values locally. Never commit the real .env file.
#
# NOTE: Host ports below are deliberately offset from the usual defaults
# (5432/6379/3000) so this stack can run alongside other local projects
# without port conflicts. Container-internal ports stay standard.

# --- App ---
NODE_ENV=development
API_PORT=3100
API_PREFIX=api/v1

# --- PostgreSQL (packages/database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_social_os
POSTGRES_PASSWORD=ai_social_os
POSTGRES_DB=ai_social_os
DATABASE_URL=postgresql://ai_social_os:ai_social_os@localhost:5433/ai_social_os

# --- Redis (packages/queue, cache, session) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- MinIO (packages/storage) ---
MINIO_ENDPOINT=localhost
# Full URL the API and workers connect to. Storage is off when this is unset.
MINIO_URL=http://localhost:9000
# Nơi TRÌNH DUYỆT gọi tới, khi khác với nơi API gọi tới. Chúng khác nhau ngay
# khi storage nằm trong mạng nội bộ: trong Docker, API gọi `http://minio:9000`,
# và link tải ký bằng host đó thì bên ngoài không mở được. Bỏ trống = giống nhau.
MINIO_PUBLIC_URL=
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=ai_social_os
MINIO_ROOT_PASSWORD=ai_social_os_secret
MINIO_BUCKET=ai-social-os
# Largest file the API accepts, in megabytes.
UPLOAD_MAX_MB=25

# --- Qdrant (packages/ai — Vector DB for RAG/Knowledge/Memory) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- Auth (packages/auth, services/api) ---
# Required, min 32 chars, no default. Generate: openssl rand -base64 48
AUTH_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# argon2id cost; lower these in CI only, never in production.
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2

# --- API Gateway (docs/platform/09_API_GATEWAY.md) ---
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_WORKSPACE_PER_HOUR=10000
PERMISSION_CACHE_TTL_SECONDS=300

# --- AI Provider Gateway (packages/ai, docs/runtime/05_PROVIDER_GATEWAY.md) ---
# Leave AI_PROVIDER empty to run without any AI vendor: the runtime falls back
# to the deterministic Phase 1 Intent/Planning engines, so a Goal still runs
# end to end with no key and no spend.
#
# Comma-separated, most preferred first — the rest are the fallback chain:
#   AI_PROVIDER=anthropic,openai
# A provider named here without its key below is skipped rather than queued as
# a certain 401.
AI_PROVIDER=
# Optional. Overrides each provider's default model; leave empty to use it.
AI_MODEL=
# Embeddings need their OWN model — AI_MODEL names a chat model, and asking a
# chat model to embed fails outright. Leave empty to use the provider's
# default (OpenAI text-embedding-3-small, Google text-embedding-004, Ollama
# nomic-embed-text). Anthropic has no embedding API, so a chain starting with
# Anthropic quietly embeds via the next provider that can.
#
# Changing this after documents are indexed means a new Qdrant collection and
# a re-index: vectors from two models cannot be compared.
AI_EMBEDDING_MODEL=
AI_TIMEOUT_MS=60000
AI_ATTEMPTS=3

# How often the runtime looks for uploaded documents to index, in ms.
INDEX_INTERVAL_MS=5000

# Keys are read from the environment, not from a per-workspace Secret Manager.
# FR-031 ("workspace brings its own key") needs an encrypted secrets store that
# does not exist yet — this is the documented interim, not the end state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI Studio: aistudio.google.com/apikey. Khoá mới có dạng "AQ.Ab8..."
# chứ không còn "AIza..." — cả hai đều hợp lệ.
#
# Bậc miễn phí (tháng 8/2026, đã thử thật):
#   gemini-2.5-flash        chạy được, viết tiếng Việt tốt
#   gemini-2.5-pro          RESOURCE_EXHAUSTED
#   mọi model sinh ảnh      RESOURCE_EXHAUSTED — hạn mức ảnh miễn phí đã về 0
#                           từ đợt cắt 12/2025. Muốn sinh ảnh phải bật thanh
#                           toán cho project Google Cloud.
GOOGLE_API_KEY=
# OpenRouter fronts several hundred models from every vendor through one key.
# Model ids carry their vendor: AI_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=
# Local Ollama needs no key. Default: http://localhost:11434/v1
OLLAMA_BASE_URL=

# --- Xu hướng (Trend Discovery) ---

# YouTube Data API v3. Lấy ở console.cloud.google.com: tạo project, bật
# "YouTube Data API v3", tạo API key. Miễn phí 10.000 đơn vị quota/ngày và bảng
# xu hướng tốn 1 đơn vị mỗi lần gọi, nên hạn mức này thực tế không chạm tới.
#
# Đây là khoá dùng chung cho cả máy chủ. Một workspace muốn tiêu quota của
# riêng mình thì lưu khoá tên "sources/youtube" ở Kho khoá — khoá riêng được
# ưu tiên, khoá này chỉ là dự phòng.
#
# Google Trends không cần khoá: nguồn dùng RSS công khai.
YOUTUBE_API_KEY=

# --- Báo lỗi qua email ---

# Không đặt gì thì không gửi email, mọi thứ chạy như cũ. Đặt một trong hai mà
# thiếu cái kia thì runtime **báo lỗi lúc khởi động** chứ không im lặng — đặt
# một nửa nghĩa là bạn định bật nó lên.
#
# Gmail: bật xác minh 2 bước rồi tạo App Password (16 ký tự), dùng nó chứ không
# phải mật khẩu tài khoản:
#   SMTP_URL=smtps://ban@gmail.com:APP_PASSWORD@smtp.gmail.com:465
# Mật khẩu có ký tự đặc biệt thì phải mã hoá URL (@ thành %40).
SMTP_URL=

# Ai nhận. Nhiều người thì ngăn bằng dấu phẩy.
ALERT_EMAIL_TO=

# Người gửi. Bỏ trống thì lấy địa chỉ nhận đầu tiên — mọi SMTP đều chấp nhận,
# còn một địa chỉ bịa ra thì hay bị từ chối.
ALERT_EMAIL_FROM=

# Đường dẫn vào giao diện, để thư báo lỗi có chỗ bấm vào.
APP_URL=http://localhost:3200

# --- Kiểm chứng với Facebook thật ---

# Chỉ dùng cho `pnpm verify:stack` và `pnpm verify:loop`. Không có hai biến này
# thì verify:stack bỏ qua phần đăng bài, còn verify:loop từ chối chạy — toàn bộ
# kịch bản của nó là về một Page thật.
#
# verify:loop ĐĂNG THẬT lên Page này rồi xoá đi. Nội dung cố định là
# "test đăng bài" và không có gì khác. Nó cũng cần SOCIAL_PUBLISH_LIVE=true.
FB_TEST_PAGE_ID=
FB_TEST_PAGE_TOKEN=

# --- Frontend (apps/web) ---
# Browser origins allowed to call the API, comma-separated. Never `*`: the
# access token travels in an Authorization header, so a wildcard would let any
# site make authenticated calls for a signed-in user.
CORS_ORIGINS=http://localhost:3200
# Where apps/web sends its requests. Must match API_PORT + API_PREFIX above.
NEXT_PUBLIC_API_URL=http://localhost:3100/api/v1

# --- Kết nối mạng xã hội (packages/connectors) ---
# Một ứng dụng cho cả hệ thống, vì đó là thứ nền tảng xét duyệt. Cái riêng theo
# workspace là *token của người dùng* mà luồng OAuth sinh ra, và nó nằm trong
# kho bí mật bên dưới.
#
# Nền tảng nào không có ID/SECRET thì vẫn hiện trên giao diện nhưng bị khoá —
# ẩn đi sẽ giống như "sản phẩm không hỗ trợ", và người vận hành không bao giờ
# biết mình quên cấu hình.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
#
# URL công khai của API, để dựng redirect_uri gửi cho nền tảng. Phải khớp đúng
# từng ký tự với URI đã đăng ký trong cài đặt ứng dụng bên đó.
#   <API_PUBLIC_URL>/<API_PREFIX>/connections/<nền tảng>/callback
API_PUBLIC_URL=http://localhost:3100
# Nơi trình duyệt quay về sau khi cấp quyền xong.
WEB_APP_URL=http://localhost:3200
#
# ĐĂNG BÀI THẬT. Mặc định TẮT, và mặc định đó là có chủ đích: bật lên là mọi
# Goal đã nằm sẵn trong hệ thống — kể cả lịch tự chạy không ai ngồi xem — sẽ
# bắt đầu đăng ra ngoài từ lần chạy kế tiếp. Đó không phải thay đổi ai đó đồng ý
# khi bấm deploy. Khi tắt, bước đăng vẫn chạy nhưng nói rõ nó không gửi đi đâu.
SOCIAL_PUBLISH_LIVE=false
#
# ĐĂNG KHI KHÔNG CÓ NGƯỜI DUYỆT. Tách riêng khỏi biến trên vì đó là hai quyết
# định khác nhau. Chuyện này đã xảy ra thật ngay trên máy phát triển: bật đăng
# thật xong, một Goal chạy theo lịch đăng bài marketing lên Page thật vài phút
# sau, không ai ngồi xem. Để false thì lịch tự chạy vẫn lập kế hoạch và viết
# nội dung, nhưng bước đăng dừng lại và nói rõ phải có người chạy tay.
SOCIAL_PUBLISH_UNATTENDED=false
#
# Chỉ đặt khi cần trỏ sang sandbox hoặc khi nhà cung cấp đổi phiên bản API.
# Phạm vi quyền (scope) CỐ TÌNH không cho đổi bằng biến môi trường: nới quyền
# tác động lên khán giả của người dùng phải là thay đổi mã nguồn có người xem.
# FACEBOOK_TOKEN_URL=
# FACEBOOK_IDENTITY_URL=
# FACEBOOK_AUTHORIZE_URL=
# FACEBOOK_GRAPH_URL=

# --- Metrics ---
# Đặt token thì `GET /metrics` mới phục vụ; bỏ trống thì endpoint trả 404 và
# không tồn tại. Mặc định tắt là có chủ ý: /metrics cho biết hình dạng lưu
# lượng, tỉ lệ lỗi và mức chi tiêu — thứ không ai bên ngoài nên đọc được.
# Scraper gửi kèm: Authorization: Bearer <token>
METRICS_TOKEN=
# Cổng runtime mở /metrics. Chỉ mở khi METRICS_TOKEN có giá trị.
RUNTIME_METRICS_PORT=3101

# --- Secret Manager (packages/secrets, docs/platform/12_SECRET_MANAGER.md) ---
# Khoá mã hoá cho kho bí mật. Dạng: id:base64,id:base64 — nhiều khoá để xoay
# vòng được mà không phải viết lại cả bảng.
#
# Sinh một khoá mới:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# MẤT khoá này là MẤT mọi bí mật đã lưu — không có đường khôi phục. Đặt sẵn
# ngay từ đầu, đừng đợi tới lúc cần.
SECRET_KEYS=
SECRET_PRIMARY_KEY=v1
#
# Khi đã đặt xong hai biến trên, mỗi workspace tự kết nối key AI của mình trên
# giao diện; key đó lưu dưới tên `providers/<tên provider>` và được dùng thay
# cho các key ở phần AI bên dưới. Workspace chưa kết nối gì thì vẫn chạy bằng
# key của nền tảng — bỏ đường lui đó nghĩa là bắt người dùng phải mua
# credential trước khi được thử sản phẩm.
