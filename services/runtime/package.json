{
  "name": "@repo/runtime-service",
  "private": true,
  "version": "0.0.0",
  "description": "Headless Execution Runtime: scheduler loop, worker dispatch, retry. See docs/kernel/",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "verify:llm": "tsx src/verify-llm.ts",
    "verify:stack": "tsx src/verify-stack.ts"
  },
  "dependencies": {
    "@repo/ai": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/event": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/runtime": "workspace:*",
    "@repo/sdk": "workspace:*",
    "ioredis": "^5.4.2",
    "@repo/knowledge": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/domain": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.38.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
